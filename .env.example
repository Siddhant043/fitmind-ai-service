REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://user:password@localhost:5672"
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
PINECONE_API_KEY="..."
PINECONE_INDEX_NAME="fitmind-knowledge"
COHERE_API_KEY="..."
NODE_ENV="development"
PORT=3001
GEMINI_API_KEY="..."

# ── Local Ollama dev ──────────────────────────────────────────
# LLM_PRIMARY_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_CHAT_MODEL=qwen3.5
# LLM_FAST_MODEL=qwen3.5
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=embeddinggemma
# EMBEDDING_DIMENSIONS=768
# PINECONE_INDEX_NAME=fitmind-knowledge-local
# COHERE_API_KEY=   # optional locally; Pinecone score fallback used if unset
#
# Prerequisite: create a separate Pinecone index at 768 dimensions (cosine metric)
# and re-index knowledge with embeddinggemma before retrieval will work locally.
# Required models: ollama pull qwen3.5 && ollama pull embeddinggemma
